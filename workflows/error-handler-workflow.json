{
  "name": "Job Application Agent - Error Handler",
  "nodes": [
    {
      "parameters": {},
      "id": "errortrigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { trace_id: $json.execution.id, failed_node: $json.execution.lastNodeExecuted, error_message: $json.execution.error?.message || 'Unknown error', timestamp: new Date().toISOString() } }];"
      },
      "id": "extracterror",
      "name": "Extract Error Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "create",
        "databaseId": "REPLACE_WITH_ERROR_LOG_DB_ID"
      },
      "id": "logerror",
      "name": "Log to Notion Error Log",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "REPLACE_WITH_YOUR_TELEGRAM_CHAT_ID",
        "text": "=🚨 Workflow failed\nTrace: {{$json.trace_id}}\nNode: {{$json.failed_node}}\nError: {{$json.error_message}}"
      },
      "id": "alerterror",
      "name": "Telegram Error Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        660,
        0
      ]
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Extract Error Details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Error Details": {
      "main": [
        [
          {
            "node": "Log to Notion Error Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log to Notion Error Log": {
      "main": [
        [
          {
            "node": "Telegram Error Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "instanceId": "job-application-agent-error-handler-v2"
  }
}